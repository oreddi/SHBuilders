# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Supabase: Project Settings > Database > Connection string)
# Use the "Session pooler" URI (port 5432) — works on Vercel and IPv4 networks.
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# PM tool admin login password (admin@shbuilders.com)
PM_PASSWORD=""

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""   # only needed for scripts/ (write access)

# Contact form email (https://resend.com)
RESEND_API_KEY=""
CONTACT_EMAIL="shbuilderstn@gmail.com"

# Public site URL (used for SEO metadata + sitemap)
NEXT_PUBLIC_SITE_URL="https://sh-builders.vercel.app"

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Vercel Analytics works without it.
NEXT_PUBLIC_GA_ID=""

# Optional: send every website lead to a CRM / Zapier / HubSpot webhook (JSON POST)
LEAD_WEBHOOK_URL=""

# PM task attachments — Supabase Storage (Project Settings > API).
# SUPABASE_URL is https://<project-ref>.supabase.co. Use the service_role / secret key:
# server only, never expose it in NEXT_PUBLIC_ variables. The private bucket is created on first upload.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# PM due-soon / overdue alerts (daily Vercel Cron, see vercel.json).
# CRON_SECRET: any long random string; Vercel sends it so only the scheduler can trigger the email.
CRON_SECRET=""
# Who gets the alert email (comma-separated). Defaults to CONTACT_EMAIL.
ALERT_EMAILS=""
